{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "certificates": {
      "type": "object",
      "properties": {
        "certManager": {
          "type": "object",
          "properties": {
            "privateKey": {
              "type": "object",
              "properties": {
                "algorithm": {"type": "string"},
                "size": {"type": "integer"}
              },
              "allOf": [
                {
                  "if": {"not": {"required": ["algorithm"]}},
                  "then": {"properties": {"size": {"enum": [2048, 4096, 8192]}}}
                },
                {
                  "if": {
                    "properties": {"algorithm": {"const": "RSA"}},
                    "required": ["algorithm"]
                  },
                  "then": {"properties": {"size": {"enum": [2048, 4096, 8192]}}}
                },
                {
                  "if": {
                    "properties": {"algorithm": {"const": "ECDSA"}},
                    "required": ["algorithm"]
                  },
                  "then": {"properties": {"size": {"enum": [256, 384, 521]}}}
                }
              ]
            },
            "caPrivateKey": {
              "type": "object",
              "properties": {
                "algorithm": {"type": "string"},
                "size": {"type": "integer"}
              },
              "allOf": [
                {
                  "if": {"not": {"required": ["algorithm"]}},
                  "then": {"properties": {"size": {"enum": [2048, 4096, 8192]}}}
                },
                {
                  "if": {
                    "properties": {"algorithm": {"const": "RSA"}},
                    "required": ["algorithm"]
                  },
                  "then": {"properties": {"size": {"enum": [2048, 4096, 8192]}}}
                },
                {
                  "if": {
                    "properties": {"algorithm": {"const": "ECDSA"}},
                    "required": ["algorithm"]
                  },
                  "then": {"properties": {"size": {"enum": [256, 384, 521]}}}
                }
              ]
            }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "serviceAccountTokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"type": "string", "enum": ["enforce-audience", "legacy"]},
            "additionalAllowedAudiences": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "outboundFilter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hashiCorpVault": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {"type": "string", "enum": ["off", "warn", "enforce"]},
                "allowedEndpoints": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^https?://[^/?#@*\\s]+/?$"}
                }
              }
            }
          }
        }
      }
    },
    "hashiCorpVault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubernetesAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {"type": "string"},
            "projectedTokenMountPath": {"type": ["string", "null"], "pattern": "^(/.*)?$"}
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "object",
          "properties": {
            "restrict": {
              "type": "object",
              "properties": {
                "serviceAccountTokenCreationRoles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
                      "namespace": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                      "audience": {"type": "string", "minLength": 1}
                    },
                    "required": ["name", "namespace"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
